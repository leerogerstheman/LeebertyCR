            { "key": "queryType", "label": "质疑类型", "type": "select", "required": true, "options": ["missing_data", "out_of_range", "inconsistent", "typo", "unclear_entry", "logic_check", "other"] },
            { "key": "priorityNote", "label": "时效要求（是否有答复期限）", "type": "text", "required": true }
          ],
          "guidance": "质疑收到即登记：编号、字段、类型、期限。积压到锁库前突击处理=答复质量崩盘的标准剧本。"
        },
        {
