      "category": "data_management",
      "gxpAreas": ["GCP"],
      "regulationRefs": [
        "ICH E6(R2) §5.5 - data handling; §4.9 - source data",
        "NMPA GCP (2020) 第八章 - 数据管理",
        "ALCOA+ - 数据完整性"
      ],
      "description": "EDC 质疑（query）从接收、回源核对、答复/修正、研究者确认到关闭的闭环。质疑是数据质量的探针：答复必须挂在源数据上。",
      "slaDays": 7,
      "requiresRootCause": false,
      "requiresEffectivenessCheck": false,
      "requiresQaApproval": false,
      "criticalityLevels": ["minor", "major"],
      "states": ["draft", "received", "verified", "answered", "reviewed", "closed", "cancelled"],
      "initialState": "draft",
      "terminalStates": ["closed", "cancelled"],
      "fields": [
        { "key": "title", "label": "质疑主题", "type": "text", "required": true, "help": "如：受试者 1003 第 6 访视血压数据矛盾" },
