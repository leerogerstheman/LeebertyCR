            { "key": "medicalData", "label": "是否涉及医学判定数据", "type": "select", "required": true, "options": ["yes", "no"] }
          ],
          "guidance": "涉及医学内容（AE、疗效、异常值）的答复必须由研究者确认——CRC 不能替研究者确认医学数据。"
        },
        {
          "code": "close",
          "name": "质疑关闭与复盘",
          "nameEn": "Closure & review",
          "role": ["crc", "pi", "cra"],
          "type": "task",
          "onComplete": "closed",
          "requiresFields": ["closeNote"],
          "form": [
            { "key": "closeNote", "label": "关闭确认（EDC 中状态）", "type": "textarea", "required": true },
            { "key": "pattern", "label": "同类质疑是否反复出现", "type": "select", "required": true, "options": ["no", "yes_recurring"] },
            { "key": "trainingHint", "label": "是否需要录入培训/流程改进", "type": "select", "required": true, "options": ["no", "yes_short_training", "yes_process_change"] }
          ],
          "guidance": "关闭不等于结束：同类质疑反复出现=录入习惯或流程问题，反馈给培训和 CRA 监查重点。单条关闭无复盘，质疑就会换个问法再来。"
        }
      ]
    }
  ]
