        { "key": "queryNo", "label": "质疑编号（EDC 中）", "type": "text", "required": true },
        { "key": "criticality", "label": "优先级", "type": "select", "required": true, "options": ["minor", "major"], "help": "涉及安全性/终点数据为 major" }
      ],
      "steps": [
        {
