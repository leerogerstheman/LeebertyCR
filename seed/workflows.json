{
  "title": "工作流库（配置驱动 · 参考 GxP-Workbench 引擎）",
  "intro": "8 个可执行的具体工作流。每个流程是一条「受控记录 + 一串有角色门槛、部分需要签署确认的步骤」：新建记录 → 按步骤推进（系统检查你的当前身份是否被该步骤允许）→ 步骤完成后状态自动流转 → 全程留痕。签名步骤要求输入姓名并确认声明；「独立复核」步骤要求由与提出者不同身份的人执行（职责分离）。",
  "roles": {
    "cra": "CRA 临床监查员（申办者一方）",
    "crc": "CRC 临床协调员（研究中心一方）",
    "pi": "研究者（医学判断与最终责任）",
    "qa": "QA/独立复核（质量保证，关闭与放行）"
  },
  "workflows": [
    {
      "code": "GCP-IC",
      "recordPrefix": "IC",
      "name": "知情同意与受试者权益事件",
      "nameEn": "Informed Consent and Subject Rights Event",
      "category": "study_event",
      "gxpAreas": ["GCP"],
      "regulationRefs": [
        "ICH E6(R2) §4.8 - informed consent; §4.8.8 required elements",
        "21 CFR 50.20 / 50.25 / 50.27 - consent requirements and documentation",
        "NMPA GCP (2020) 第二十四条 - 知情同意要求",
        "Declaration of Helsinki §25-32"
      ],
      "description": "记录并处理知情同意相关事件：签署晚于试验操作、要素缺失、版本未更新、重新同意遗漏、特殊情况（文盲/未成年人/紧急情况）保护不足等。涉及受试者权益，严重程度起点为 major。",
      "slaDays": 10,
      "requiresRootCause": true,
      "requiresEffectivenessCheck": true,
      "requiresQaApproval": true,
      "criticalityLevels": ["major", "critical"],
      "states": ["draft", "identified", "assessed", "reported", "capa_open", "closed", "cancelled"],
      "initialState": "draft",
      "terminalStates": ["closed", "cancelled"],
      "fields": [
        { "key": "title", "label": "事件标题", "type": "text", "required": true },
        { "key": "summary", "label": "事件描述", "type": "textarea", "required": true },
        { "key": "protocolNumber", "label": "试验方案编号及版本", "type": "text", "required": true },
        { "key": "subjectId", "label": "受试者编号", "type": "text", "required": false, "help": "仅记录编号，本系统不存储受试者身份信息" },
        { "key": "site", "label": "研究中心", "type": "text", "required": true },
        { "key": "occurredAt", "label": "发生日期", "type": "date", "required": true },
        { "key": "criticality", "label": "严重程度", "type": "select", "required": true, "options": ["major", "critical"], "help": "知情同意事件默认 major；若受试者已接受试验操作或涉及特殊人群，应为 critical" }
      ],
      "steps": [
        {
          "code": "identify",
          "name": "识别与记录",
          "nameEn": "Identification and recording",
          "role": ["cra", "crc", "pi", "qa"],
          "type": "task",
          "onComplete": "identified",
          "form": [
            { "key": "eventType", "label": "事件类型", "type": "select", "required": true, "options": ["consent_after_procedure", "missing_required_element", "outdated_version_used", "reconsent_omitted", "no_witness_for_illiterate", "consent_not_documented", "subject_not_given_time", "vulnerable_subject", "icf_not_irb_approved", "other"] },
            { "key": "factualAccount", "label": "事实描述（客观、可核查）", "type": "textarea", "required": true },
            { "key": "consentDate", "label": "知情同意签署日期", "type": "date", "required": true },
            { "key": "firstProcedureDate", "label": "首个试验相关操作日期", "type": "date", "required": true, "help": "含筛选检查；此日期必须晚于知情同意签署日期" },
            { "key": "sourceDataRef", "label": "源数据引用", "type": "text", "required": false, "help": "病历页码、ICF 原件编号、门诊记录" }
          ],
          "guidance": "先判断事实，再谈责任：对比「ICF 签署日期」与「首个试验操作日期」是核查核心。筛选检查也属于试验操作——签署晚于筛选即为偏离。所有事实必须可核查（引用病历/文件位置），不得写推测。"
        },
        {
          "code": "assess_impact",
          "name": "受试者权益与数据影响评估",
          "nameEn": "Subject rights & data impact assessment",
          "role": ["pi", "cra", "qa"],
          "type": "signature",
          "signatureMeaning": "reviewed",
          "onComplete": "assessed",
          "requiresFields": ["subjectRightsImpact", "dataIntegrityImpact", "dataUseDecision", "overallImpact", "rootCause"],
          "persistFields": { "impact_assessment": "overallImpact", "root_cause": "rootCause" },
          "form": [
            { "key": "subjectRightsImpact", "label": "对受试者权益与安全的影响", "type": "textarea", "required": true, "help": "受试者是否在充分知情前提下参与？是否经历了本可避免的检查或用药？" },
            { "key": "dataIntegrityImpact", "label": "对数据完整性的影响", "type": "textarea", "required": true },
            { "key": "dataUseDecision", "label": "该受试者数据的可用性判定", "type": "select", "required": true, "options": ["data_usable", "data_usable_with_sensitivity", "data_excluded", "irb_decision_required"] },
            { "key": "subjectContinues", "label": "受试者是否继续参加", "type": "select", "required": true, "options": ["continues", "continues_with_monitoring", "withdrawn_by_subject", "withdrawn_by_investigator", "not_applicable"] },
            { "key": "overallImpact", "label": "总体影响结论", "type": "textarea", "required": true },
            { "key": "rootCause", "label": "根本原因", "type": "textarea", "required": true }
          ],
          "guidance": "知情同意的缺陷不能被「受试者表示理解」弥补——书面知情同意是法规要求。涉及特殊人群时，数据可用性判定可能需要伦理委员会参与，研究者不得单方决定。"
        },
        {
          "code": "report",
          "name": "报告与通报",
          "nameEn": "Reporting and notification",
          "role": ["pi", "cra", "qa"],
          "type": "task",
          "onComplete": "reported",
          "requiresFields": ["irbNotified", "sponsorNotified"],
          "form": [
            { "key": "irbNotified", "label": "伦理委员会通报", "type": "select", "required": true, "options": ["yes", "no", "not_required"] },
            { "key": "irbDate", "label": "伦理通报日期", "type": "date", "required": false },
            { "key": "irbResponse", "label": "伦理意见要点", "type": "textarea", "required": false, "help": "是否要求重新知情同意、排除数据、提交进展报告" },
            { "key": "sponsorNotified", "label": "申办者通报", "type": "select", "required": true, "options": ["yes", "no", "not_required"] },
            { "key": "regulatoryNotified", "label": "监管机构通报", "type": "select", "required": true, "options": ["yes", "no", "assess_further"] },
            { "key": "reconsentRequired", "label": "是否需要重新知情同意", "type": "select", "required": true, "options": ["yes_subject_specific", "yes_all_subjects", "no"] }
          ],
          "guidance": "知情同意类事件通常必须通报伦理委员会。若属系统性做法（如筛选流程设计问题），受影响的是全部受试者，必须排查，不能只当个例处理。"
        },
        {
          "code": "capa",
          "name": "纠正预防措施",
          "nameEn": "Corrective & preventive action",
          "role": ["pi", "cra", "qa", "crc"],
          "type": "task",
          "onComplete": "capa_open",
          "requiresFields": ["correctiveActions", "preventiveActions", "capaOwner", "capaDueDate"],
          "form": [
            { "key": "correctiveActions", "label": "纠正措施（受试者层面）", "type": "textarea", "required": true, "help": "补充知情、重新同意、退出试验、医学随访" },
            { "key": "preventiveActions", "label": "预防措施（流程层面）", "type": "textarea", "required": true, "help": "修订筛选流程图、增加 ICF 核查清单、系统强制拦截" },
            { "key": "siteRetraining", "label": "研究中心再培训", "type": "select", "required": true, "options": ["yes", "no", "not_required"] },
            { "key": "capaOwner", "label": "措施责任人", "type": "text", "required": true },
            { "key": "capaDueDate", "label": "措施期限", "type": "date", "required": true }
          ],
          "guidance": "知情同意问题的预防措施通常落在流程与系统层面（访视顺序、系统质疑），仅重复培训通常不足以关闭。"
        },
        {
          "code": "close",
          "name": "关闭（独立复核）",
          "nameEn": "Closure - independent review",
          "role": ["qa", "pi"],
          "type": "signature",
          "signatureMeaning": "closed",
          "onComplete": "closed",
          "independentOfAuthor": true,
          "requiresFields": ["conclusion", "effectivenessResult"],
          "persistFields": { "effectiveness_result": "effectivenessResult" },
          "form": [
            { "key": "conclusion", "label": "关闭结论", "type": "textarea", "required": true },
            { "key": "dataUseFinal", "label": "数据最终处理方式", "type": "select", "required": true, "options": ["included_in_analysis", "included_with_sensitivity", "excluded_from_analysis", "excluded_from_efficacy_only"] },
            { "key": "effectivenessMethod", "label": "有效性检查方法", "type": "textarea", "required": true, "help": "如：后续 20 例 ICF 流程 100% 核对结果、下次监查专项核查" },
            { "key": "effectivenessResult", "label": "有效性结论", "type": "select", "required": true, "options": ["effective", "partially_effective", "not_effective"] }
          ],
          "guidance": "本步骤要求独立复核（ICH Q10 §3.2 / Annex 11 §12.1）：事件的提出人不能自己关闭。若你当前身份与提出人相同，请切换到 QA 或研究者身份执行。ICH E3 要求临床研究报告列出所有重要偏离及其处理，不得因「已补救」而省略。"
        }
      ]
    },
    {
      "code": "GCP-PD",
      "recordPrefix": "PD",
      "name": "临床试验方案偏离",
      "nameEn": "Clinical Protocol Deviation",
      "category": "study_event",
      "gxpAreas": ["GCP"],
      "regulationRefs": [
        "ICH E6(R2) §4.5 - compliance with protocol; §4.5.4 deviations documented",
        "ICH E6(R2) §5.18.4 - monitoring; §5.20 - deviation reporting",
        "ICH E3 §9.2 - reporting of protocol deviations",
        "NMPA GCP (2020) - 方案依从与偏离"
      ],
      "description": "记录、评估并报告偏离已批准试验方案的事件，区分重要偏离与一般偏离，判断对受试者安全与数据可靠性的影响，闭环整改。",
      "slaDays": 14,
      "requiresRootCause": true,
      "requiresEffectivenessCheck": true,
      "requiresQaApproval": true,
      "criticalityLevels": ["minor", "major", "critical"],
      "states": ["draft", "identified", "assessed", "reported", "capa_open", "closed", "cancelled"],
      "initialState": "draft",
      "terminalStates": ["closed", "cancelled"],
      "fields": [
        { "key": "title", "label": "偏离标题", "type": "text", "required": true },
        { "key": "summary", "label": "偏离描述", "type": "textarea", "required": true },
        { "key": "protocolNumber", "label": "试验方案编号及版本", "type": "text", "required": true },
        { "key": "subjectId", "label": "受试者编号", "type": "text", "required": false, "help": "若为受试者相关偏离。本系统不存储受试者身份信息" },
        { "key": "site", "label": "研究中心", "type": "text", "required": true },
        { "key": "occurredAt", "label": "发生日期", "type": "date", "required": true },
        { "key": "criticality", "label": "严重程度", "type": "select", "required": true, "options": ["minor", "major", "critical"] }
      ],
      "steps": [
        {
          "code": "identify",
          "name": "识别与记录",
          "nameEn": "Identification and recording",
          "role": ["cra", "crc", "pi", "qa"],
          "type": "task",
          "onComplete": "identified",
          "form": [
            { "key": "deviationType", "label": "偏离类型", "type": "select", "required": true, "options": ["informed_consent", "inclusion_exclusion", "visit_window", "prohibited_medication", "study_procedure", "ip_handling", "randomisation", "blinding", "assessment_omitted", "safety_reporting", "other"] },
            { "key": "protocolRequirement", "label": "方案要求原文（章节+内容）", "type": "textarea", "required": true, "help": "引用方案章节号及原文，便于核查" },
            { "key": "actualConduct", "label": "实际执行情况", "type": "textarea", "required": true },
            { "key": "discoveredBy", "label": "发现人及方式", "type": "text", "required": true, "help": "监查、稽查、自查、受试者反馈" },
            { "key": "sourceDataRef", "label": "原始数据来源", "type": "text", "required": false, "help": "病历、检验报告、日记卡、药物发放记录" }
          ],
          "guidance": "所有方案偏离都必须记录，包括研究者主动报告的和监查发现的。不得因认为「不严重」而不记录——严重程度由评估步骤判定，不是提出人说了算。"
        },
        {
          "code": "assess_impact",
          "name": "影响评估",
          "nameEn": "Impact assessment",
          "role": ["pi", "cra", "qa"],
          "type": "signature",
          "signatureMeaning": "reviewed",
          "onComplete": "assessed",
          "requiresFields": ["importantDeviation", "subjectSafetyImpact", "dataIntegrityImpact", "overallImpact", "rootCause"],
          "persistFields": { "impact_assessment": "overallImpact", "root_cause": "rootCause" },
          "form": [
            { "key": "importantDeviation", "label": "是否属于重要偏离", "type": "select", "required": true, "options": ["yes", "no"], "help": "重要偏离：可能显著影响受试者权益/安全/福祉，或试验数据的完整性与可靠性" },
            { "key": "subjectSafetyImpact", "label": "对受试者安全的影响", "type": "textarea", "required": true },
            { "key": "dataIntegrityImpact", "label": "对数据完整性的影响", "type": "textarea", "required": true },
            { "key": "subjectContinues", "label": "受试者是否继续参加试验", "type": "select", "required": true, "options": ["continues", "continues_with_monitoring", "withdrawn", "not_applicable"] },
            { "key": "overallImpact", "label": "总体影响结论", "type": "textarea", "required": true },
            { "key": "rootCause", "label": "根本原因", "type": "textarea", "required": true }
          ],
          "guidance": "影响评估中受试者安全的医学判断必须由研究者做出。监查员不能代替研究者评估受试者安全。"
        },
        {
          "code": "report",
          "name": "报告与通报",
          "nameEn": "Reporting and notification",
          "role": ["pi", "cra", "qa"],
          "type": "task",
          "onComplete": "reported",
          "requiresFields": ["irbNotified", "sponsorNotified"],
          "form": [
            { "key": "irbNotified", "label": "伦理委员会通报", "type": "select", "required": true, "options": ["yes", "no", "not_required"] },
            { "key": "irbDate", "label": "通报日期", "type": "date", "required": false },
            { "key": "sponsorNotified", "label": "申办者通报", "type": "select", "required": true, "options": ["yes", "no", "not_required"] },
            { "key": "regulatoryNotified", "label": "监管机构通报", "type": "select", "required": true, "options": ["yes", "no", "not_required"], "help": "重要偏离可能需按当地法规报告" },
            { "key": "protocolAmendmentNeeded", "label": "是否需要修订方案", "type": "select", "required": true, "options": ["yes", "no"] }
          ],
          "guidance": "重要偏离通常必须通报伦理委员会。是否报监管机构取决于当地法规与偏离性质。"
        },
        {
          "code": "capa",
          "name": "纠正预防措施",
          "nameEn": "Corrective & preventive action",
          "role": ["pi", "cra", "qa", "crc"],
          "type": "task",
          "onComplete": "capa_open",
          "requiresFields": ["capaOwner", "capaDueDate"],
          "form": [
            { "key": "processChange", "label": "流程改进措施", "type": "textarea", "required": true },
            { "key": "siteRetraining", "label": "研究中心再培训", "type": "select", "required": true, "options": ["yes", "no", "not_required"] },
            { "key": "monitoringPlanChange", "label": "监查计划调整", "type": "textarea", "required": false, "help": "如：将该中心列为重点监查、增加现场访视频次" },
            { "key": "capaOwner", "label": "措施责任人", "type": "text", "required": true },
            { "key": "capaDueDate", "label": "措施期限", "type": "date", "required": true }
          ],
          "guidance": "反复发生的同类偏离说明培训或流程存在系统性问题，仅重复培训通常不足以关闭。"
        },
        {
          "code": "close",
          "name": "关闭（独立复核）",
          "nameEn": "Closure - independent review",
          "role": ["qa", "pi"],
          "type": "signature",
          "signatureMeaning": "closed",
          "onComplete": "closed",
          "independentOfAuthor": true,
          "requiresFields": ["conclusion", "dataUsedInAnalysis"],
          "persistFields": { "effectiveness_result": "dataUsedInAnalysis" },
          "form": [
            { "key": "conclusion", "label": "关闭结论", "type": "textarea", "required": true },
            { "key": "dataUsedInAnalysis", "label": "受影响数据是否纳入分析", "type": "select", "required": true, "options": ["yes_all", "yes_sensitivity_analysis", "excluded", "per_protocol_definition"] },
            { "key": "listedInReport", "label": "是否列入临床研究报告", "type": "select", "required": true, "options": ["yes", "no"] },
            { "key": "effectivenessCheckDate", "label": "有效性检查日期", "type": "date", "required": false }
          ],
          "guidance": "ICH E3 要求临床研究报告必须列出所有重要方案偏离及其处理方式。本步骤要求独立复核：提出人不能自己关闭（Annex 11 §12.1）。"
        }
      ]
    },
    {
      "code": "MON-CYCLE",
      "recordPrefix": "MV",
      "name": "监查访视闭环",
      "nameEn": "Monitoring Visit Closure Cycle",
      "category": "monitoring",
      "gxpAreas": ["GCP"],
      "regulationRefs": [
        "ICH E6(R2) §5.18 - monitoring purpose; §5.18.4/5 - SDV and monitoring report",
        "ICH E6(R2) §5.20 - deviation reporting"
      ],
      "description": "CRA 的核心日常闭环：访视计划 → 现场核对 → 问题与中心确认 → 随访信（正式发出）→ 中心整改 → 复核关闭。每一步都有产出，问题不闭环流程不结束。",
      "slaDays": 30,
      "requiresRootCause": false,
      "requiresEffectivenessCheck": true,
      "requiresQaApproval": false,
      "criticalityLevels": ["minor", "major"],
      "states": ["draft", "planned", "verified", "confirmed", "fu_sent", "remediated", "closed", "cancelled"],
      "initialState": "draft",
      "terminalStates": ["closed", "cancelled"],
      "fields": [
        { "key": "title", "label": "访视主题", "type": "text", "required": true, "help": "如：XX 中心 2026-05 常规监查" },
        { "key": "summary", "label": "访视目的与重点", "type": "textarea", "required": true },
        { "key": "protocolNumber", "label": "试验方案编号及版本", "type": "text", "required": true },
        { "key": "site", "label": "研究中心", "type": "text", "required": true },
        { "key": "visitDate", "label": "计划访视日期", "type": "date", "required": true },
        { "key": "criticality", "label": "计划风险等级", "type": "select", "required": true, "options": ["minor", "major"], "help": "按监查计划/RBM：入组期、既往问题多的中心为 major" }
      ],
      "steps": [
        {
          "code": "plan",
          "name": "访视计划与准备",
          "nameEn": "Visit planning & preparation",
          "role": ["cra"],
          "type": "task",
          "onComplete": "planned",
          "requiresFields": ["lastOpenIssues", "sdvScope", "fileNeeds", "agendaSent"],
          "form": [
            { "key": "lastOpenIssues", "label": "上次遗留问题清单（编号+状态）", "type": "textarea", "required": true },
            { "key": "sdvScope", "label": "本次 SDV 范围（受试者/条目，依据 SDRP）", "type": "textarea", "required": true },
            { "key": "fileNeeds", "label": "需要中心准备的文件/病历", "type": "textarea", "required": true },
            { "key": "agendaSent", "label": "议程与预约已通知中心", "type": "select", "required": true, "options": ["yes", "no"] }
          ],
          "guidance": "访视质量=访视前功课。先把上次遗留问题、EDC 质疑、SAE 状态、入组进度过一遍，带着清单去现场。"
        },
        {
          "code": "verify",
          "name": "现场监查与核对",
          "nameEn": "On-site monitoring & verification",
          "role": ["cra"],
          "type": "task",
          "onComplete": "verified",
