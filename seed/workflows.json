        { "key": "protocolNumber", "label": "试验方案编号及版本", "type": "text", "required": true },
        { "key": "site", "label": "研究中心", "type": "text", "required": true },
        { "key": "covDate", "label": "计划关闭访视日期", "type": "date", "required": true },
