            { "key": "discrepancy", "label": "差异类型", "type": "select", "required": true, "options": ["entry_error", "source_missing", "source_error", "no_error_clarify", "other"] }
          ],
          "guidance": "答复前必做：找到源数据位置、记录原始内容。三种情况分开处理：录入错=走修正流程；源数据缺=先补源数据；都没错=如实澄清。"
        },
        {
          "code": "answer",
          "name": "答复或修正",
          "nameEn": "Answer or correction",
          "role": ["crc"],
          "type": "task",
          "onComplete": "answered",
          "requiresFields": ["answerText", "correctionNote"],
          "form": [
